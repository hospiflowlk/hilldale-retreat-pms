# Hilldale Retreat PMS — Environment Variables
# Copy this to .env and fill in your values

# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://admin:password@localhost:5432/hilldale_pms

# Server port (Railway sets PORT automatically)
PORT=3001

# JWT secret (change this to a long random string in production!)
JWT_SECRET=change-this-to-a-long-random-secret-string

# Node environment
NODE_ENV=production
